# Copy this file to .env and fill in the values from your Supabase project.

# Optional direct PostgreSQL connection for /health/db and database integration tests.
# Supabase dashboard > Connect > Session pooler. Replace the password placeholder.
DATABASE_URL=

# Required for /health/supabase, which checks PostgreSQL through the Supabase Data API.
# Supabase project URL: dashboard Connect dialog or Project Settings > Data API.
SUPABASE_URL=

# Project Settings > API Keys > Secret key (starts with sb_secret_). Server only, never share it.
SUPABASE_SECRET_KEY=
