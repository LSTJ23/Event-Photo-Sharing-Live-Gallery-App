# Copy this file to .env and fill in the values from your Supabase project.

# Supabase dashboard > Connect > Session pooler. Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=

# Project Settings > Data API
SUPABASE_URL=

# Project Settings > API Keys > Secret key (starts with sb_secret_). Server only, never share it.
SUPABASE_SECRET_KEY=
