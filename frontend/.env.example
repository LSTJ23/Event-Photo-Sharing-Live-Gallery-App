# Copy this file to .env.local and fill in the values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side URL of the Express API for authentication requests.
AUTH_BACKEND_URL=http://localhost:3001

# Optional: leave the URL unset to use the built-in mock data.
# NEXT_PUBLIC_API_URL=http://localhost:3001
# Keep mock data even when a backend URL is configured.
# NEXT_PUBLIC_USE_MOCK_API=true